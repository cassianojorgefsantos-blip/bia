# =============================================================================
# Variáveis de ambiente do projeto BIA
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório
# =============================================================================

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bia
DB_USER=postgres
DB_PASS=

# Porta do servidor (padrão: 8080)
PORT=8080

# Cache Redis (opcional — deixe vazio para desabilitar)
CACHE_ENDPOINT=
CACHE_TTL=60

# Senha de administrador
# Usada para ações restritas como "Limpar tudo" no painel de recados
# Defina uma senha forte antes de ir para produção
ADMIN_KEY=sua_senha_aqui
